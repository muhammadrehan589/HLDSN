<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Your existing CircleImageStyle -->
    <style name="CircleImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ADD THIS: Centered Material3 AlertDialog overlay -->
    <style name="ThemeOverlay.Material3.MaterialAlertDialog.Centered"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
    </style>

</resources>