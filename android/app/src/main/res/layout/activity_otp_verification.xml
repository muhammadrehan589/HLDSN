<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_gradient"
    tools:context=".OtpVerificationActivity">

    <ImageView
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:src="@drawable/login_status_bar"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/backArrow"
        android:layout_width="16dp"
        android:layout_height="23dp"
        android:src="@android:drawable/ic_menu_revert"
        android:tint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintTop_margin="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintStart_margin="32dp" />

    <TextView
        android:id="@+id/otpSubtitle"
        android:layout_width="318dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2sp"
        android:text="Please enter 6 digit Code sent to your registered mobile number +92 xx xxx xxx xx"
        android:textAlignment="viewStart"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_margin="35dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="18dp"
        app:layout_constraintTop_toBottomOf="@id/otpTitle" />

    <TextView
        android:id="@+id/otpTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="serif"
        android:text="Enter OTP"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.178"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="48dp"
        app:layout_constraintTop_toBottomOf="@id/statusBar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/otpContainer"
        android:layout_width="0dp"
        android:layout_height="239dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/otp_container_background"
        app:layout_constraintEnd_margin="34dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_margin="34dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="31dp"
        app:layout_constraintTop_toBottomOf="@id/otpSubtitle">

        <LinearLayout
            android:id="@+id/otpInputLayout"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            app:layout_constraintEnd_margin="11dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_margin="11dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_margin="29dp"
            app:layout_constraintTop_toTopOf="parent">

            <EditText
                android:id="@+id/otpDigit1"
                android:layout_width="43dp"
                android:layout_height="42dp"
                android:background="@drawable/otp_box_background"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="0"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textColorHint="#BFFFFFFF"
                android:textSize="18sp" />

            <Space
                android:layout_width="13dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/otpDigit2"
                android:layout_width="43dp"
                android:layout_height="42dp"
                android:background="@drawable/otp_box_background"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="0"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textColorHint="#BFFFFFFF"
                android:textSize="18sp" />

            <Space
                android:layout_width="13dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/otpDigit3"
                android:layout_width="43dp"
                android:layout_height="42dp"
                android:background="@drawable/otp_box_background"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="0"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textColorHint="#BFFFFFFF"
                android:textSize="18sp" />

            <Space
                android:layout_width="13dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/otpDigit4"
                android:layout_width="43dp"
                android:layout_height="42dp"
                android:background="@drawable/otp_box_background"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="0"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textColorHint="#BFFFFFFF"
                android:textSize="18sp" />

            <Space
                android:layout_width="13dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/otpDigit5"
                android:layout_width="43dp"
                android:layout_height="42dp"
                android:background="@drawable/otp_box_background"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="0"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textColorHint="#BFFFFFFF"
                android:textSize="18sp" />

            <Space
                android:layout_width="13dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/otpDigit6"
                android:layout_width="43dp"
                android:layout_height="42dp"
                android:background="@drawable/otp_box_background"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="0"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textColorHint="#BFFFFFFF"
                android:textSize="18sp" />

        </LinearLayout>

        <Button
            android:id="@+id/submitButton"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="36dp"
            android:backgroundTint="#FE8E00"
            android:fontFamily="sans-serif-medium"
            android:text="Submit"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:cornerRadius="15dp"
            app:layout_constraintEnd_margin="53dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_margin="53dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_margin="69dp"
            app:layout_constraintTop_toBottomOf="@id/otpInputLayout" />

        <TextView
            android:id="@+id/resendText"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_marginTop="40dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Not received the code? Resend"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintEnd_margin="75dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_margin="75dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_margin="26dp"
            app:layout_constraintTop_toBottomOf="@id/submitButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

