<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_gradient"
    tools:context=".SignupActivity">

    <ImageView
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:src="@drawable/signup_status_bar"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/backArrow"
        android:layout_width="16dp"
        android:layout_height="23dp"
        android:src="@android:drawable/ic_menu_revert"
        android:tint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintTop_margin="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintStart_margin="32dp" />

    <TextView
        android:id="@+id/signupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign-up"
        android:textSize="32sp"
        android:textColor="#FFFFFF"
        android:fontFamily="serif"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintTop_margin="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Welcome to HLDSN –\nYour safety companion — alerts, SOS, and local help at your fingertips.\nAlready have an account? login"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="4sp"
        app:layout_constraintTop_toBottomOf="@id/signupTitle"
        app:layout_constraintTop_margin="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_margin="35dp"
        app:layout_constraintEnd_margin="35dp" />

    <EditText
        android:id="@+id/firstNameField"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="First Name"
        android:textColorHint="#BFFFFFFF"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/signup_field_background"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        app:layout_constraintTop_toBottomOf="@id/welcomeText"
        app:layout_constraintTop_margin="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_margin="35dp"
        app:layout_constraintEnd_margin="35dp" />

    <EditText
        android:id="@+id/lastNameField"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Last Name"
        android:textColorHint="#BFFFFFFF"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/signup_field_background"
        android:paddingStart="21dp"
        android:paddingEnd="21dp"
        app:layout_constraintTop_toBottomOf="@id/firstNameField"
        app:layout_constraintTop_margin="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_margin="35dp"
        app:layout_constraintEnd_margin="35dp" />

    <EditText
        android:id="@+id/mobileNumberField"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Mobile Number"
        android:textColorHint="#BFFFFFFF"
        android:textColor="#FFFFFFFF"
        android:inputType="phone"
        android:background="@drawable/signup_field_background"
        android:paddingStart="23dp"
        android:paddingEnd="23dp"
        app:layout_constraintTop_toBottomOf="@id/lastNameField"
        app:layout_constraintTop_margin="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_margin="35dp"
        app:layout_constraintEnd_margin="35dp" />

    <EditText
        android:id="@+id/emailField"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Email"
        android:textColorHint="#BFFFFFFF"
        android:textColor="#FFFFFFFF"
        android:inputType="textEmailAddress"
        android:background="@drawable/signup_field_background"
        android:paddingStart="23dp"
        android:paddingEnd="23dp"
        app:layout_constraintTop_toBottomOf="@id/mobileNumberField"
        app:layout_constraintTop_margin="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_margin="35dp"
        app:layout_constraintEnd_margin="35dp" />

    <EditText
        android:id="@+id/passwordField"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Password"
        android:textColorHint="#BFFFFFFF"
        android:textColor="#FFFFFFFF"
        android:inputType="textPassword"
        android:background="@drawable/signup_field_background"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/emailField"
        app:layout_constraintTop_margin="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_margin="35dp"
        app:layout_constraintEnd_margin="35dp" />

    <EditText
        android:id="@+id/confirmPasswordField"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Confirm Password"
        android:textColorHint="#BFFFFFFF"
        android:textColor="#FFFFFFFF"
        android:inputType="textPassword"
        android:background="@drawable/signup_field_background"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        app:layout_constraintTop_toBottomOf="@id/passwordField"
        app:layout_constraintTop_margin="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_margin="35dp"
        app:layout_constraintEnd_margin="35dp" />

    <CheckBox
        android:id="@+id/termsCheckbox"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:buttonTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/confirmPasswordField"
        app:layout_constraintTop_margin="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintStart_margin="43dp" />

    <TextView
        android:id="@+id/termsText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="by signing up, you agree to the SLDA terms & condition"
        android:textSize="10sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        app:layout_constraintTop_toTopOf="@id/termsCheckbox"
        app:layout_constraintStart_toEndOf="@id/termsCheckbox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_margin="9dp"
        app:layout_constraintEnd_margin="43dp" />

    <Button
        android:id="@+id/submitButton"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Submit"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FE8E00"
        android:fontFamily="sans-serif-medium"
        app:cornerRadius="15dp"
        app:layout_constraintTop_toBottomOf="@id/termsCheckbox"
        app:layout_constraintTop_margin="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_margin="35dp"
        app:layout_constraintEnd_margin="35dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

