<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#0F1F1D"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Incident Image -->
        <ImageView
            android:id="@+id/incidentImage"
            android:layout_width="80dp"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_fire"
            android:contentDescription="Incident image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Incident Type -->
        <TextView
            android:id="@+id/incidentType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Fire Outbreak"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            app:layout_constraintStart_toEndOf="@id/incidentImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/incidentImage" />

        <!-- Description -->
        <TextView
            android:id="@+id/incidentDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="16dp"
            android:text="A major fire has broken out in the downtown area, affecting multiple buildings."
            android:textColor="#D9F3F0"
            android:textSize="14sp"
            android:maxLines="3"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/incidentImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/incidentType" />

        <!-- Location (FIXED) -->
        <TextView
            android:id="@+id/incidentLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="16dp"
            android:text="Location: Downtown District, City Center"
            android:textColor="#E6FFFFFF"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/incidentImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/incidentDescription" />

        <!-- Reporter Safety Status -->
        <TextView
            android:id="@+id/reporterSafety"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reporter is safe: Yes"
            android:textColor="#2DD09E"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/incidentLocation"
            app:layout_constraintTop_toBottomOf="@id/incidentLocation" />

        <!-- View More trigger -->
        <Button
            android:id="@+id/viewMoreCommentsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="View more"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="@id/reporterSafety"
            app:layout_constraintTop_toBottomOf="@id/reporterSafety" />

        <!-- Scrollable inline comments (revealed after View More) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/commentPreviewContainer"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:background="#1AFFFFFF"
            android:padding="12dp"
            android:visibility="gone"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="true"
            app:layout_constraintStart_toStartOf="@id/viewMoreCommentsButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/viewMoreCommentsButton">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="\"Emergency services responded within minutes.\""
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="\"Evacuation assisted by nearby residents.\""
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="\"Need additional water tankers on-site.\""
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="\"Coordination with local shelters is ongoing.\""
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="\"Volunteers are distributing water and blankets.\""
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
