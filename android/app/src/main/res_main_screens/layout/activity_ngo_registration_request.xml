<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/notification_gradient_bg"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="@drawable/homepage_appbar_background"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="18dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="NGO Registration Request"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/ngoNameField"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/volunteer_input_field_bg"
                android:hint="NGO Name"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#575757" />

            <EditText
                android:id="@+id/ngoRegistrationNumberField"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/volunteer_input_field_bg"
                android:hint="Registration Number"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#575757" />

            <EditText
                android:id="@+id/ngoCityField"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/volunteer_input_field_bg"
                android:hint="City"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#575757" />

            <EditText
                android:id="@+id/ngoContactField"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/volunteer_input_field_bg"
                android:hint="Contact Number"
                android:inputType="phone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#575757" />

            <EditText
                android:id="@+id/ngoDescriptionField"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/volunteer_input_field_bg"
                android:gravity="top|start"
                android:hint="Describe your NGO mission and services"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:padding="14dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#575757" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitNgoRequestButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="Submit Request"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
