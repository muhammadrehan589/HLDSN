<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Header with gradient and icons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="@drawable/header_gradient"
            android:elevation="4dp">

            <!-- Menu icon (left) -->
            <ImageView
                android:id="@+id/menu_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menu" />

            <!-- App name (center) -->
            <TextView
                android:id="@+id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="HLDSN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="28sp"
                android:fontFamily="serif"
                android:letterSpacing="0.05"
                android:shadowColor="#33000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="2" />

            <!-- Notification area with badge -->
            <FrameLayout
                android:id="@+id/notification_badge_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp">

                <ImageView
                    android:id="@+id/notification_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_notification"
                    android:contentDescription="Notifications" />

                <TextView
                    android:id="@+id/tv_notification_count"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/circle_red_badge"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:includeFontPadding="false"
                    tools:text=""
                    tools:visibility="visible" />

            </FrameLayout>
        </RelativeLayout>

        <!-- Banner Section -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/banner_card_bg"
            android:clipToOutline="true"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/banner_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/flood_banner" />

            <!-- Carousel Dots (example) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/dot_active" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/dot_inactive" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/dot_inactive" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/dot_inactive" />
            </LinearLayout>
        </FrameLayout>

        <!-- Emergency SOS Button -->
        <Button
            android:id="@+id/btn_emergency"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            android:backgroundTint="#E94F7A"
            android:text="Emergency | SOS"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="22sp"
            android:fontFamily="sans-serif" />

        <!-- Contacts Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:background="#D8D8D8"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/section_chip_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Contacts"
                android:textColor="#3A3A3A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Fire Rescue -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_contact_fire"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="Fire Rescue"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_fire"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

                <!-- Edhi Foundation -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_contact_edhi"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="Edhi Foundation"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_edhi"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

                <!-- Hospital -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_contact_hospital"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="Hospital"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_hospital"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

                <!-- Police -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_contact_police"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="Police"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_police"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Services Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:background="#D8D8D8"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/section_chip_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Services"
                android:textColor="#3A3A3A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- CAMP Locations -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_service_camp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="CAMP Locations"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_camp"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

                <!-- Volunteer Network -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_service_volunteer"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="Volunteer Network"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_volunteer"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

                <!-- Hazard Alert -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_service_alert"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="Hazard Alert"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_hazard"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

                <!-- Chats -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_service_chats"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="Chats"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_chat"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Information Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="24dp"
            android:background="#D8D8D8"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="140dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/section_chip_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Information"
                android:textColor="#3A3A3A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Safety Tips -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_info_safety"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="Safety Tips"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_safety"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

                <!-- Emergency Preparedness -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_info_preparedness"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="Emergency Preparedness"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_preparedness"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

                <!-- First Aid Tips -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_info_first_aid"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="First Aid Tips"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_firstaid"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

                <!-- News -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_info_news"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="News"
                    android:textAllCaps="false"
                    android:textColor="#0A1F1F"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="#FFFFFFFF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_news"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="#1A000000"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>