<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_secondary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Header with gradient and icons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="@drawable/header_gradient"
            android:elevation="4dp">

            <!-- Menu icon (left) -->
            <ImageView
                android:id="@+id/menu_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menu" />

            <!-- App name (center) -->
            <TextView
                android:id="@+id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="HLDSN"
                android:textColor="@color/text_on_primary"
                android:textStyle="bold"
                android:textSize="28sp"
                android:fontFamily="serif"
                android:letterSpacing="0.05"
                android:shadowColor="#33000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="2" />

            <!-- Notification area with badge -->
            <FrameLayout
                android:id="@+id/notification_badge_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp">

                <ImageView
                    android:id="@+id/notification_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_notification"
                    android:contentDescription="Notifications" />

                <TextView
                    android:id="@+id/tv_notification_count"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/circle_red_badge"
                    android:textColor="@color/text_on_primary"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:includeFontPadding="false"
                    tools:text=""
                    tools:visibility="visible" />

            </FrameLayout>
        </RelativeLayout>

        <!-- Radio state warning banners (hidden by default, shown programmatically) -->
        <LinearLayout
            android:id="@+id/radio_warnings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Bluetooth off warning -->
            <LinearLayout
                android:id="@+id/warning_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#CC7A1A"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="⚠  Bluetooth is off — SOS mesh unavailable"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_enable_bluetooth"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turn On"
                    android:textColor="#FFE082"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Location off warning -->
            <LinearLayout
                android:id="@+id/warning_location"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#B22222"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="⚠  Location is off — SOS location sharing unavailable"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_enable_location"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turn On"
                    android:textColor="#FFE082"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- News Carousel Section -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/news_view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/banner_card_bg"
                android:clipToOutline="true" />

            <!-- Carousel Dots -->
            <LinearLayout
                android:id="@+id/carousel_dots_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal" />

            <!-- Skeleton loading overlay shown while news is being fetched -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/carousel_shimmer_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/banner_card_bg">

                    <!-- Skeleton image placeholder -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#2A3A5C" />

                    <!-- Skeleton text line at bottom -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <View
                            android:layout_width="220dp"
                            android:layout_height="14dp"
                            android:layout_marginBottom="6dp"
                            android:background="#3D5080" />

                        <View
                            android:layout_width="160dp"
                            android:layout_height="12dp"
                            android:background="#3D5080" />

                    </LinearLayout>

                </FrameLayout>

            </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>


        <!-- Emergency SOS Button -->
        <Button
            android:id="@+id/btn_emergency"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            android:backgroundTint="@color/brand_red"
            android:text="@string/emergency_sos"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:textStyle="bold"
            android:textSize="22sp"
            android:fontFamily="sans-serif" />

        <!-- Contacts Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/surface_chip"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/section_chip_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/contacts"
                android:textColor="@color/heading_medium"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Emergency Numbers -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_emergency_numbers"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="@string/emergency_numbers"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/button_bg"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_emergency_numbers"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/button_stroke"
                    app:strokeWidth="1dp" />

                <!-- Nearby Help -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nearby_help"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="@string/nearby_help"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/button_bg"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_location"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/button_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Chats -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_service_chats"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="@string/chats"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/button_bg"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_chat"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/button_stroke"
                    app:strokeWidth="1dp" />

                <!-- Community Chat -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_info_community_chat"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="@string/community_chat"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/button_bg"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_community_chat"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/button_stroke"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Services Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/surface_chip"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/section_chip_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/services"
                android:textColor="@color/heading_medium"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- CAMP Locations -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_service_camp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="@string/camp_locations"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/button_bg"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_camp"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/button_stroke"
                    app:strokeWidth="1dp" />

                <!-- Volunteer Network -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_service_volunteer"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="@string/volunteer_network"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/button_bg"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_volunteer"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/button_stroke"
                    app:strokeWidth="1dp" />

                <!-- Hazard Alert -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_service_alert"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="@string/hazard_alert"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/button_bg"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_hazard"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/button_stroke"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Information Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="24dp"
            android:background="@color/surface_chip"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="140dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/section_chip_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/information"
                android:textColor="@color/heading_medium"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Safety Tips -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_info_safety"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="@string/safety_tips"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/button_bg"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_safety"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/button_stroke"
                    app:strokeWidth="1dp" />

                <!-- Community Chat -->
                <!-- First Aid Tips -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_info_first_aid"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="@string/emergency_first_aid_card"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/button_bg"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_firstaid"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/button_stroke"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- News -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_info_news"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:minHeight="120dp"
                    android:text="@string/news"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/button_bg"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_news"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="44dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/button_stroke"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>