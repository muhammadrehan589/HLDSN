<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launch_gradient_bg"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp"
    tools:context=".LaunchActivity">

    <ImageView
        android:id="@+id/logoMark"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:adjustViewBounds="true"
        android:contentDescription="HLDSN Logo"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_logo_mark"
        app:layout_constraintBottom_toTopOf="@id/logoWordmark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="16dp" />

    <TextView
        android:id="@+id/logoWordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="HLDSN"
        android:textAlignment="center"
        android:textColor="#FFFFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoMark"
        app:layout_goneMarginBottom="8dp"
        app:layout_goneMarginTop="20dp" />

    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:text="STAY CONNECTED, STAY SAFE"
        android:textAlignment="center"
        android:textColor="#FFFFFFFF"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoWordmark"
        app:layout_goneMarginTop="6dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
