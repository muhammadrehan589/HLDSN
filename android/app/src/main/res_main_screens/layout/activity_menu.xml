<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_gradient"
    >

    <!-- Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/header_gradient"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:layout_marginTop="35dp"
            android:layout_marginStart="15dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:layout_marginTop="27dp"
            android:layout_marginStart="11dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/backButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Menu Items Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Profile Menu Item -->
            <androidx.cardview.widget.CardView
                android:id="@+id/profileMenuItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1AFFFFFF"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:minHeight="64dp">

                    <ImageView
                        android:id="@+id/profileIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_profile_avatar"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/profileText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Profile"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="@id/profileIcon"
                        app:layout_constraintBottom_toBottomOf="@id/profileIcon"
                        app:layout_constraintStart_toEndOf="@id/profileIcon"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- Home Menu Item -->
            <androidx.cardview.widget.CardView
                android:id="@+id/homeMenuItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1AFFFFFF"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/profileMenuItem"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:minHeight="64dp">

                    <ImageView
                        android:id="@+id/homeIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_home"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/homeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="@id/homeIcon"
                        app:layout_constraintBottom_toBottomOf="@id/homeIcon"
                        app:layout_constraintStart_toEndOf="@id/homeIcon"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- About Menu Item -->
            <androidx.cardview.widget.CardView
                android:id="@+id/aboutMenuItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1AFFFFFF"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/homeMenuItem"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:minHeight="64dp">

                    <ImageView
                        android:id="@+id/aboutIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_info"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/aboutText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="About us"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="@id/aboutIcon"
                        app:layout_constraintBottom_toBottomOf="@id/aboutIcon"
                        app:layout_constraintStart_toEndOf="@id/aboutIcon"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- NGO Registration Menu Item -->
            <androidx.cardview.widget.CardView
                android:id="@+id/ngoRegistrationMenuItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1AFFFFFF"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/aboutMenuItem"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:minHeight="64dp">

                    <ImageView
                        android:id="@+id/ngoRegistrationIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_camp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/ngoRegistrationText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="NGO Registration"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="@id/ngoRegistrationIcon"
                        app:layout_constraintBottom_toBottomOf="@id/ngoRegistrationIcon"
                        app:layout_constraintStart_toEndOf="@id/ngoRegistrationIcon"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/logoutMenuItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:layout_constraintTop_toBottomOf="@id/ngoRegistrationMenuItem"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:minHeight="64dp">

                    <ImageView
                        android:id="@+id/logoutIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_logout"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/logoutText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Logout"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="@id/logoutIcon"
                        app:layout_constraintBottom_toBottomOf="@id/logoutIcon"
                        app:layout_constraintStart_toEndOf="@id/logoutIcon"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

