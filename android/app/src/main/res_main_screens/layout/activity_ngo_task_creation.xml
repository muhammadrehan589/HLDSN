<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/notification_gradient_bg"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="@drawable/homepage_appbar_background"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="18dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Create Task"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/taskTitleField"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/volunteer_input_field_bg"
                android:hint="Task name"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#575757" />

            <EditText
                android:id="@+id/taskDescriptionField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/volunteer_input_field_bg"
                android:gravity="top"
                android:hint="Task description"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#575757" />

            <TextView
                android:id="@+id/volunteerSelector"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/volunteer_input_field_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:hint="Tap to select volunteers"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#575757" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/volunteer_input_field_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deadlinePickerButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set Deadline"
                    android:textAllCaps="false"
                    android:textColor="#575757"
                    app:icon="@android:drawable/ic_menu_my_calendar"
                    app:iconTint="#575757"
                    app:rippleColor="#22000000" />

                <TextView
                    android:id="@+id/deadlineDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="No deadline set"
                    android:textColor="#999999"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitTaskButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Create Task"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>