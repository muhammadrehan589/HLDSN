<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/notification_item_bg"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/thumbFlood"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/notification_thumb_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/flood_banner"
            android:outlineProvider="bounds" />

        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-6dp"
            android:layout_marginTop="-6dp"
            android:background="@drawable/notification_badge_bg"
            android:gravity="center"
            android:text="2"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/textFlood"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/thumbFlood"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/timeFlood"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flood Warning"
            android:textColor="#FF5A43"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Heavy rainfall detected. Flood risk is rising. Move to higher ground and avoid low-lying areas"
            android:textColor="#D5F0E7"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/timeFlood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1m ago."
        android:textColor="#AEE3CF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
