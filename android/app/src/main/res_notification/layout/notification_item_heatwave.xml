<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/notification_item_bg"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/thumbHeatwave"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/notification_thumb_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background_heatwave_tips"
            android:outlineProvider="bounds" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/textHeatwave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/thumbHeatwave"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/timeHeatwave"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heatwave Alert"
            android:textColor="@color/text_on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Heatwave approaching. Secure loose items and stay indoors until conditions improve."
            android:textColor="@color/text_on_primary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/timeHeatwave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15 Hrs ago."
        android:textColor="@color/text_on_primary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
