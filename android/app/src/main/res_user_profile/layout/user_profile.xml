<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_gradient"
    tools:context=".login_module.UserProfileActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- App Bar Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="@drawable/header_gradient"
            tools:ignore="MissingConstraints">

            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menu"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="35dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="15dp" />

            <TextView
                android:id="@+id/profileTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="32sp"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="27dp"
                app:layout_constraintStart_toEndOf="@id/menuIcon"
                android:layout_marginStart="11dp" />

            <ImageView
                android:id="@+id/notificationIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_notification"
                android:contentDescription="Notifications"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="44dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="15dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- Back Arrow -->

        <Button
            android:id="@+id/editprofile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/purple_500"
            android:text="Edit Profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.109"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profileImage" />

        <ImageView
            android:id="@+id/backArrow"
            android:layout_width="16dp"
            android:layout_height="23dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:layout_constraintTop_toBottomOf="@id/header"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="32dp" />

        <!-- Profile Image - Moved 24dp lower (7dp → 31dp) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileImage"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="90dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"/>


        <!-- Name, Address, Phone Card - Now independent of profile image position -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#1A2B2B2B"
            app:layout_constraintTop_toBottomOf="@id/header"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toEndOf="@id/profileImage"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- Name -->
                <TextView
                    android:id="@+id/nameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/nameField"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/nameLabel"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Address -->
                <TextView
                    android:id="@+id/addressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintTop_toBottomOf="@id/nameField"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/addressField"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/addressLabel"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Phone no. -->
                <TextView
                    android:id="@+id/phoneLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone no."
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintTop_toBottomOf="@id/addressField"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/phoneField"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/phoneLabel"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Age, Blood, Height, Weight Card - Now independent of profile image -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#1A2B2B2B"
            app:layout_constraintTop_toBottomOf="@id/header"
            android:layout_marginTop="300dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">


                <!-- Age -->
                <TextView
                    android:id="@+id/ageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"

                    android:fontFamily="sans-serif"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/ageField"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/ageLabel"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Blood group -->
                <TextView
                    android:id="@+id/bloodLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blood group"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintTop_toBottomOf="@id/ageField"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/bloodField"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/bloodLabel"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Height -->
                <TextView
                    android:id="@+id/heightLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Height"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintTop_toBottomOf="@id/bloodField"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/heightField"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/heightLabel"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Weight -->
                <TextView
                    android:id="@+id/weightLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintTop_toBottomOf="@id/heightField"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/weightField"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/weightLabel"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Emergency Contacts Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardEmergencyContacts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#1A2B2B2B"
            app:layout_constraintTop_toBottomOf="@id/cardStats"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <TextView
                    android:id="@+id/emergencyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergency Contacts"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/contactField1"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/emergencyTitle"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/contactField2"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/contactField1"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/contactField3"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/contactField2"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Allergies Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAllergies"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#1A2B2B2B"
            app:layout_constraintTop_toBottomOf="@id/cardEmergencyContacts"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <TextView
                    android:id="@+id/allergiesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allergies and Reactions"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/allergyField1"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/allergiesTitle"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/allergyField2"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/allergyField1"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/allergyField3"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/allergyField2"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Injuries Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardInjuries"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#1A2B2B2B"
            app:layout_constraintTop_toBottomOf="@id/cardAllergies"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <TextView
                    android:id="@+id/injuriesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post injuries and Operations done"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/injuryField1"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/injuriesTitle"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/injuryField2"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/injuryField1"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/injuryField3"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:background="@drawable/profile_field_background"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint=""
                    android:textColorHint="#BFFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/injuryField2"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>