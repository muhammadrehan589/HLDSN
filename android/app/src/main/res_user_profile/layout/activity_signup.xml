<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/login_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="16dp"
            android:layout_height="23dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF"
            tools:ignore="NotSibling" />

        <TextView
            android:id="@+id/signupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Sign-up"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout_editor_absoluteY="84dp"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Welcome to HLDSN –\nYour safety companion — alerts, SOS, and local help at your fingertips.\nAlready have an account? login"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4sp"
            app:layout_constraintTop_toBottomOf="@id/signupTitle"
            android:layout_marginTop="18dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- First Name -->
        <EditText
            android:id="@+id/firstNameField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="First Name"
            android:textColorHint="#BFFFFFFF"
            android:textColor="@color/text_primary"
            android:background="@drawable/signup_field_background"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/welcomeText"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Last Name -->
        <EditText
            android:id="@+id/lastNameField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Last Name"
            android:textColorHint="#BFFFFFFF"
            android:textColor="@color/text_primary"
            android:background="@drawable/signup_field_background"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/firstNameField"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Mobile Number -->
        <EditText
            android:id="@+id/mobileNumberField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Mobile Number"
            android:inputType="phone"
            android:textColorHint="#BFFFFFFF"
            android:textColor="@color/text_primary"
            android:background="@drawable/signup_field_background"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/lastNameField"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Email -->
        <EditText
            android:id="@+id/emailField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:textColorHint="#BFFFFFFF"
            android:textColor="@color/text_primary"
            android:background="@drawable/signup_field_background"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/mobileNumberField"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Password -->
        <EditText
            android:id="@+id/passwordField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:textColorHint="#BFFFFFFF"
            android:textColor="@color/text_primary"
            android:background="@drawable/signup_field_background"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/emailField"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Confirm Password -->
        <EditText
            android:id="@+id/confirmPasswordField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:textColorHint="#BFFFFFFF"
            android:textColor="@color/text_primary"
            android:background="@drawable/signup_field_background"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/passwordField"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Terms & Checkbox -->
        <CheckBox
            android:id="@+id/termsCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/confirmPasswordField"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/termsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="By signing up, you agree to the SLDA terms conditions"
            android:textSize="10sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif"
            app:layout_constraintTop_toTopOf="@id/termsCheckbox"
            app:layout_constraintStart_toEndOf="@id/termsCheckbox"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="0dp"/>

        <!-- Submit Button -->
        <Button
            android:id="@+id/submitButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:backgroundTint="@color/accent_orange"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="15dp"
            app:layout_constraintTop_toBottomOf="@id/termsCheckbox"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
