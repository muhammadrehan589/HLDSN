<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== HARDWARE FEATURES (Optional) ==================== -->
    <!-- Camera is optional -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Location is optional (app works without it) -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Bluetooth is optional -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Wi-Fi is optional -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />

    <!-- ==================== PERMISSIONS ==================== -->

    <!-- Media Images (Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- External Storage (for Android versions below 13) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Nearby Devices Discovery (Recommended for Android 12+ / API 31+) -->
    <!-- These replace old BLUETOOTH/ADMIN permissions for discovery & connection -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />

    <!-- Optional: Legacy Bluetooth (for devices below Android 12) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Wi-Fi State (needed for Wi-Fi Direct on older versions) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Internet (required for Firebase, ImageKit, etc.) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service (required for SosListenerService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        tools:targetApi="34" />

    <!-- Vibration (SOS alert feedback) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wake lock (keep CPU alive during offline SOS broadcast) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ==================== APPLICATION ==================== -->
    <application
        android:name=".HldsnApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HLDSN"
        tools:targetApi="31">

        <!-- Launcher Activity -->
        <activity
            android:name=".home.LaunchActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Other Activities -->
        <activity android:name=".login_module.LoginActivity" android:exported="false" />
        <activity android:name=".login_module.SignupActivity" android:exported="false" />
        <activity android:name=".home.Main" android:exported="false" />
        <activity android:name=".home.HomePageActivity" android:exported="false" />
        <activity android:name=".volunteer_module.CampLocationsMapActivity" android:exported="false" />
        <activity android:name=".home.EmergencyNumbersActivity" android:exported="false" />
        <activity android:name=".firstaid.EmergencyFirstAidActivity" android:exported="false" />
        <activity android:name=".firstaid.FirstAidDetailActivity" android:exported="false" />
        <activity android:name=".volunteer_module.VolunteerNetworkMapActivity" android:exported="false" />
        <activity android:name=".hazard_module.HazardAlertMapActivity" android:exported="false" />
        <activity android:name=".volunteer_module.VolunteerBasicFormActivity" android:exported="false" />
        <activity android:name=".volunteer_module.VolunteerSkillsFormActivity" android:exported="false" />
        <activity android:name=".volunteer_module.VolunteerAgreementActivity" android:exported="false" />
        <activity android:name=".volunteer_module.VolunteerSuccessActivity" android:exported="false" />
        <activity android:name=".incident_report_module.ChatsActivity" android:exported="false" />
        <activity android:name=".incident_report_module.ConversationActivity" android:exported="false" />
        <activity android:name=".incident_report_module.ReportIncidentActivity" android:exported="false" />
        <activity android:name=".services.safety_tips.SafetyTipsActivity" android:exported="false" />
        <activity android:name=".services.news.NewsActivity" android:exported="false" />
        <activity android:name=".services.news.NewsDetailActivity" android:exported="false" />
        <activity android:name=".login_module.SaveUserProfileActivity" android:exported="false" />
        <activity android:name=".login_module.UserProfileActivity" android:exported="false" />
        <activity android:name=".notification_module.NotificationDetailActivity" android:exported="false" />
        <activity android:name=".notification_module.VolunteerNotificationsActivity" android:exported="false" />
        <activity android:name=".volunteer_module.VolunteerAssignedTasksActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoTaskCreationActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoTaskListActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoResourceCreationActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoResourceListActivity" android:exported="false" />

        <activity android:name=".incident_report_module.DisplayReportActivity" android:exported="false"/>
        <activity android:name=".services.safety_tips.SafetyTypeActivity" android:exported="false"/>
        <activity android:name=".sos.SosDetailActivity" android:exported="false"/>
        <activity android:name=".admin_module.AdminDashboardActivity" android:exported="false" />
        <activity android:name=".admin_module.AdminNgoManagementActivity" android:exported="false" />
        <activity android:name=".admin_module.AdminUsersManagementActivity" android:exported="false" />
        <activity android:name=".admin_module.AdminNgoRequestsActivity" android:exported="false" />
        <activity android:name=".admin_module.AdminIncidentReportsActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoDashboardActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoNotificationsActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoCampCenterFormActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoCampCenterMapPickerActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoCampCenterManagementActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoVolunteerApprovalsActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoRegistrationRequestActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoViewVolunteersActivity" android:exported="false" />
        <activity android:name=".ngo_module.NgoVolunteerDetailActivity" android:exported="false" />
        <activity android:name=".nearby.NearbyHelpActivity" android:exported="false" />

        <service
            android:name=".sos.SosForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- SOS background listener service -->
        <service
            android:name=".sos.SosListenerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />


    </application>

</manifest>